    """Grouped bars: one group per flow, one bar per protocol; a row per track, a column per scenario."""
    agg, flows = load(metric)
    tracks = [t for t in ("BBox", "PCloud") if t in set(agg["track"])]
    scenarios = [s for s in ("urban", "highway") if s in set(agg["scenario"])]
    cfgs = [c for c in ORDER if c in set(agg["config"])]

    fig = plt.gcf()
    fig.clear()
    fig.set_layout_engine("compressed")
    fig.set_size_inches(16, 4.6 * len(tracks))
    # Share y within a row: the two scenarios are comparable for a given track; the two tracks are
    # three orders of magnitude apart and get their own scale (and their own unit).
    axes = fig.subplots(len(tracks), len(scenarios), sharey="row", squeeze=False)

    x = np.arange(len(flows))
    pitch = 0.84 / len(cfgs)
    width = pitch * 0.82          # leaves a surface gap between adjacent bars

    for r, track in enumerate(tracks):
        sp = spec[track]
        row_min = np.inf                      # smallest plotted value, for the log-axis floor
        for c, scen in enumerate(scenarios):
            ax = axes[r][c]
            d = agg[(agg["track"] == track) & (agg["scenario"] == scen)]
            for i, cfg in enumerate(cfgs):
                s = d[d["config"] == cfg].set_index("flow").reindex(flows)
                off = (i - (len(cfgs) - 1) / 2.0) * pitch
                ax.bar(x + off, s["mean"] * sp["scale"], width,
                       yerr=s["ci"] * sp["scale"], capsize=1.5,
                       color=COLOR[cfg], label=LEGEND.get(cfg, cfg),
                       error_kw=dict(lw=0.8, ecolor="#52514e"))
                v = (s["mean"] * sp["scale"]).dropna()
                v = v[v > 0]
                if len(v):
                    row_min = min(row_min, float(v.min()))
            ax.set_xticks(x)
            ax.set_xticklabels(flows, fontsize=8)
            ax.set_xlim(-0.6, len(flows) - 0.4)
            # Grid on the value axis only; groups are separated by an explicit rule BETWEEN them
            # (an x-grid would put its line through the middle of a group instead).
            ax.grid(axis="y", alpha=0.3)
            ax.grid(axis="x", visible=False)
            ax.set_axisbelow(True)
            for b in x[:-1]:
                ax.axvline(b + 0.5, color="#c3c2b7", linewidth=0.6, zorder=0)
            if sp.get("logy"):
                ax.set_yscale("log")
            if sp.get("ylim") is not None:
                ax.set_ylim(*sp["ylim"])
            elif not sp.get("logy"):
                ax.set_ylim(bottom=0)
            if sp.get("hline") is not None:
                ax.axhline(sp["hline"], color="crimson", linestyle="--", linewidth=1.2)
                # In the corner, not on the line: bars run the full width of the panel, so a label
                # sitting next to the line always lands on one of them.
                ax.text(0.012, 0.97, "- - " + sp["hlabel"], transform=ax.transAxes,
                        ha="left", va="top", color="crimson", fontsize=8,
                        bbox=dict(facecolor="white", edgecolor="none", alpha=0.75, pad=1.5))
            ax.set_title("%s track -- %s" % (track, scen), fontsize=10)
            if c == 0:
                ax.set_ylabel(sp["ylabel"], fontsize=9)
            if r == len(tracks) - 1:
                ax.set_xlabel("subscriber", fontsize=9)

        # Log panels autoscale down to a full decade below the data, which wastes half the panel.
        # Anchor the floor just under the smallest bar (and under the deadline, so it stays on
        # screen), and leave headroom at the top for the deadline caption.
        if sp.get("logy") and np.isfinite(row_min):
            floor = min(row_min, sp["hline"]) if sp.get("hline") else row_min
            ax0 = axes[r][0]
            ax0.set_ylim(bottom=floor / 1.8, top=ax0.get_ylim()[1] * 1.7)

    handles, labels = axes[0][0].get_legend_handles_labels()
    try:
        fig.legend(handles, labels, loc="outside lower center", ncol=len(cfgs), fontsize=9,
                   frameon=False)
    except ValueError:      # older Matplotlib: no outside-legend support under this layout engine
        fig.legend(handles, labels, loc="lower center", ncol=len(cfgs), fontsize=9, frameon=False)
    fig.suptitle(title, fontsize=12)
    return agg

props = chart.get_properties()
utils.preconfigure_plot(props)

# BBox is a 50 B / 100 ms track (a few kbps) and PCloud is the 300 KB / 200 ms bulk (Mbps), so the
# two rows carry their own unit rather than being forced onto one log axis.
SPEC = {
    "BBox":   dict(scale=1e-3, ylabel="goodput delivered (kbps)"),
    "PCloud": dict(scale=1e-6, ylabel="goodput delivered (Mbps)"),
}
agg = per_flow_bars("throughput", SPEC,
                    "Goodput per subscriber, by protocol (received bytes / observation window; "
                    "publisher car[0])")

utils.postconfigure_plot(props)
utils.export_image_if_needed(props)
utils.export_data_if_needed(agg, props)
]]></script>
            <property name="Graph.Title" value="Per-subscriber goodput: every protocol on every subscriber"/>
        </chart>
        <chart createdWith="OMNeT++ 6.3.0" icon="icons/full/obj/linechart.png" id="910000020" name="RQ1_priority_vs_window" resultTypes="scalar" template="generic_mpl" type="MATPLOTLIB">
            <script><![CDATA[from omnetpp.scave import results, chart, utils
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

# Does QUIC-level priority scheduling substitute for a bounded flow-control window?
# A reader reaching the conclusion asks this: the headline runs use round-robin, so
# perhaps the 2 MB bufferbloat result is a scheduling artefact rather than a queueing one.
# It is not. Both arms sweep the same 10 windows with the same seed at each window
# (-r sets the seed set), so the pairwise difference isolates the scheduler.
#
# Data: results/sweep (MOQ_Partial_Window, round-robin) vs results/sweep_prio
# (MOQ_Partial_Prio_Window, streamScheduler="Priority"), plus 5-seed points at the two
# operating points from results/prio_oppoint and results/urban.

T95 = {1: 12.706, 2: 4.303, 3: 3.182, 4: 2.776, 5: 2.571, 6: 2.447, 7: 2.365, 8: 2.306, 9: 2.262}
def ci95(x):
    x = x.dropna()
    return 0.0 if len(x) < 2 else T95.get(len(x) - 1, 1.96) * x.std(ddof=1) / np.sqrt(len(x))

def to_bytes(w):
    w = str(w).strip()
    if w.endswith("MB"): return float(w[:-2]) * 1e6
    if w.endswith("kB"): return float(w[:-2]) * 1e3
    return float(w)

def load(cfg, metric):
    """Per-window mean over subscriber cars, deduplicated by (window, seed set).

    sweep_prio and prio_oppoint share a config name and overlap on one run
    (2 MB / seed 0 and 128 kB / seed 4 appear in both), so collapsing on
    (window, seedset) keeps each seed counted exactly once."""
    df = results.get_scalars(
        f'name =~ "*BBox*{metric}*" AND runattr:configname =~ "{cfg}"',
        include_itervars=True, include_runattrs=True)
    if df.empty:
        return pd.DataFrame(columns=["window", "mean", "ci", "n"])
    df = df[df["value"].notna()]
    df = df[~df["module"].str.contains(r"car\[0\]", regex=True)]   # subscribers only
    df["window"] = df["win"].map(to_bytes) / 1e3
    key = "seedset" if "seedset" in df.columns else "runID"
    per_seed = df.groupby(["window", key])["value"].mean().reset_index()
    agg = per_seed.groupby("window")["value"].agg(["mean", ci95, "count"]).reset_index()
    agg.columns = ["window", "mean", "ci", "n"]
    return agg.sort_values("window")

def load_bdp(metric):
    """Round-robin 5-seed reference at the 128 kB operating point (MOQ_Partial_BDP)."""
    df = results.get_scalars(f'name =~ "*BBox*{metric}*" AND runattr:configname =~ "MOQ_Partial_BDP"',
                             include_runattrs=True)
    if df.empty:
        return None
    df = df[df["value"].notna()]
    df = df[~df["module"].str.contains(r"car\[0\]", regex=True)]
    per_run = df.groupby("runID")["value"].mean()
    return per_run.mean(), ci95(per_run), len(per_run)

RR, PRIO = "#2b6cb0", "#c05621"       # validated pair: CVD dE 20.9 (protan), normal 27.3
OPPOINT, DEADLINE = "#2f855a", "#c53030"
WINDOWS = [64, 128, 256, 300, 350, 400, 450, 512, 1000, 2000]

props = chart.get_properties()
utils.preconfigure_plot(props)
fig = plt.gcf(); fig.clear()
fig.set_layout_engine("compressed"); fig.set_size_inches(12, 5)
axes = fig.subplots(1, 2, squeeze=False)[0]

PANELS = [(0, "meanLatency", 1000, "BBox mean latency (ms)", True, 100),
          (1, "deadlineMissRatio", 100, "BBox deadline miss (%)", False, None)]

export = []
for idx, metric, scale, ylabel, logy, deadline in PANELS:
    ax = axes[idx]
    for cfg, label, colour, style, marker in [
            ("MOQ_Partial_Window",      "Round-robin (default)", RR,   "-",  "o"),
            ("MOQ_Partial_Prio_Window", "Priority scheduler",    PRIO, "--", "s")]:
        d = load(cfg, metric)
        if d.empty:
            continue
        a = d.copy(); a["scheduler"] = label; a["metric"] = metric; export.append(a)
        # Identity is carried by colour AND dash pattern AND marker, never colour alone.
        ax.plot(d["window"], d["mean"] * scale, style, marker=marker, markersize=8,
                linewidth=2, color=colour, label=label, zorder=3)
        # Multi-seed points get error bars; single-seed points must not imply a CI.
        m = d[d["n"] > 1]
        if not m.empty:
            ax.errorbar(m["window"], m["mean"] * scale, yerr=m["ci"] * scale, fmt="none",
                        ecolor=colour, elinewidth=2, capsize=5, zorder=4)
            ax.scatter(m["window"], m["mean"] * scale, s=110, facecolors="white",
                       edgecolors=colour, linewidths=2, zorder=5)
    ref = load_bdp(metric)
    if ref is not None:
        mu, hw, n = ref
        ax.errorbar([128], [mu * scale], yerr=[hw * scale], fmt="none",
                    ecolor=RR, elinewidth=2, capsize=5, zorder=4)
        ax.scatter([128], [mu * scale], s=110, facecolors="white", edgecolors=RR,
                   linewidths=2, zorder=5)

    ax.axvline(128, color=OPPOINT, linewidth=1.3, zorder=1)
    if deadline is not None:
        ax.axhline(deadline, color=DEADLINE, linestyle="--", linewidth=1.2, zorder=1)
        ax.text(1900, deadline * 1.15, "100 ms deadline", ha="right", va="bottom",
                fontsize=8, color=DEADLINE)
    ax.set_xscale("log")
    if logy:
        ax.set_yscale("log")
    else:
        ax.set_ylim(-3, 103)
    ax.set_xticks(WINDOWS)
    ax.set_xticklabels([str(w) for w in WINDOWS], fontsize=7, rotation=45)
    ax.minorticks_off()
    ax.set_xlim(55, 2600)
    ax.set_xlabel("QUIC flow-control window (kB)  [log]", fontsize=9)
    ax.set_ylabel(ylabel, fontsize=9)
    ax.grid(alpha=0.3, which="major")
    for s in ("top", "right"):
        ax.spines[s].set_visible(False)

axes[0].legend(loc="upper left", fontsize=9, framealpha=0.9)
fig.suptitle("Priority scheduling does not substitute for a bounded window\n"
             "Both arms track each other: at 2 MB the backlog already sits below QUIC, "
             "where the scheduler cannot reorder it", fontsize=12)
fig.text(0.5, 0.005,
         "Hollow markers with error bars are 5-seed means (95% CI) at the two operating points; "
         "all other points are a single seed, and each window uses a different seed. "
         "Green line = 128 kB operating point.",
         ha="center", fontsize=8, style="italic", color="#4a5568")

combined = pd.concat(export, ignore_index=True) if export else pd.DataFrame()
utils.postconfigure_plot(props)
utils.export_image_if_needed(props)
utils.export_data_if_needed(combined, props)
]]></script>
            <property name="Graph.Title" value="Priority scheduling vs bounded window (urban)"/>
        </chart>
    </charts>
</analysis>
