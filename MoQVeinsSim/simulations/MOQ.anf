        <chart createdWith="OMNeT++ 6.3.0" icon="icons/full/obj/linechart.png" id="910000001" name="RQ2_BBox_latency" resultTypes="scalar" template="generic_mpl" type="MATPLOTLIB">
            <script><![CDATA[from omnetpp.scave import results, chart, utils
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

# --- shared helpers -------------------------------------------------------------------------
# Runs are produced by scripts/run-comparison.sh into results/{urban,highway}/seedN/.
# Config names carry the scenario: the "_HW" suffix means highway.
ORDER = ["MOQ_Partial_BDP", "MOQ_SW_BDP", "MOQ_QUIC", "MQTT_QUIC", "MOQ_UDP", "MOQ_TCP", "MQTT_TCP"]
LABEL = {
    "MOQ_Partial_BDP": "MoQ partial\n(128kB)",
    "MOQ_SW_BDP":      "MoQ reliable\n(128kB)",
    "MOQ_QUIC":        "MoQ / QUIC\n(default)",
    "MQTT_QUIC":       "MQTT / QUIC",
    "MOQ_UDP":         "MoQ / UDP",
    "MOQ_TCP":         "MoQ / TCP",
    "MQTT_TCP":        "MQTT / TCP",
}
# t(0.975, dof) for small samples
T95 = {1: 12.706, 2: 4.303, 3: 3.182, 4: 2.776, 5: 2.571, 6: 2.447, 7: 2.365, 8: 2.306, 9: 2.262}

def ci95(x):
    x = x.dropna()
    n = len(x)
    if n < 2:
        return 0.0
    return T95.get(n - 1, 1.96) * x.std(ddof=1) / np.sqrt(n)

def load(metric_filter):
    """Return a frame with one row per (config, scenario, seed): the mean over subscriber cars."""
    df = results.get_scalars(metric_filter, include_itervars=True, include_runattrs=True)
    if df.empty:
        raise chart.ChartScriptError(
            "No data. Generate it with:  ./scripts/run-all.sh results 5")
    df = df[df["value"].notna()]
    # Split the scenario out of the config name.
    df["scenario"] = np.where(df["configname"].str.endswith("_HW"), "highway", "urban")
    df["config"] = df["configname"].str.replace("_HW$", "", regex=True)
    # MoQ over TCP/UDP and MQTT keep their own names; map ini configs onto the chart labels.
    df["config"] = df["config"].replace({"MOQ": "MOQ_QUIC"})
    df = df[df["config"].isin(ORDER)]
    # One value per run (mean across subscriber cars), then aggregate across seeds.
    per_run = df.groupby(["config", "scenario", "runID"])["value"].mean().reset_index()
    return per_run

def grouped_bar(per_run, ylabel, title, scale=1.0, logy=False, pct=False,
                hline=None, hline_label=None, ylim=None):
    agg = per_run.groupby(["config", "scenario"])["value"].agg(["mean", ci95, "count"])
    agg.columns = ["mean", "ci", "n"]
    agg = agg.reset_index()

    cfgs = [c for c in ORDER if c in set(agg["config"])]
    x = np.arange(len(cfgs))

    # Small multiples: one panel per scenario, shared y-axis. Urban and highway are two
    # INDEPENDENT test-beds -- they differ in speed, propagation, topology and handover all at
    # once -- so they are faceted, not drawn as adjacent bars. Read the per-protocol pattern
    # WITHIN each panel; agreement ACROSS panels is robustness, not an urban-vs-highway contrast
    # (which this design cannot support -- too many factors differ between the two).
    scenarios = [s for s in [("urban", "#2b6cb0"), ("highway", "#c05621")]
                 if s[0] in set(agg["scenario"])]

    fig = plt.gcf()
    fig.clear()
    fig.set_layout_engine("compressed")
    fig.set_size_inches(13, 5)
    axes = fig.subplots(1, len(scenarios), sharey=True, squeeze=False)[0]

    for ax, (scen, colour) in zip(axes, scenarios):
        d = agg[agg["scenario"] == scen].set_index("config").reindex(cfgs)
        ax.bar(x, d["mean"] * scale, 0.7, yerr=d["ci"] * scale, capsize=3,
               color=colour, alpha=0.85)
        ax.set_xticks(x)
        ax.set_xticklabels([LABEL.get(c, c) for c in cfgs], fontsize=8)
        ax.set_title(scen, fontsize=11)
        ax.grid(axis="y", alpha=0.3)
        if logy:
            ax.set_yscale("log")
        if hline is not None:
            ax.axhline(hline, color="crimson", linestyle="--", linewidth=1.2)
            if hline_label:
                ax.annotate(hline_label, xy=(0, hline), xytext=(3, 4),
                            textcoords="offset points", color="crimson", fontsize=9)
        if ylim is not None:
            ax.set_ylim(*ylim)

    axes[0].set_ylabel(ylabel)
    fig.suptitle(title)
    return agg

props = chart.get_properties()
utils.preconfigure_plot(props)

per_run = load('name =~ "track*BBox*meanLatency*"')
# The deadline is the thing that matters, so draw it -- on every panel (hline= inside grouped_bar).
agg = grouped_bar(per_run, "BBox mean end-to-end latency (ms)  [log scale]",
                  "Safety-critical track: latency by protocol (mean of 5 seeds, 95% CI)",
                  scale=1000, logy=True, hline=100, hline_label="100 ms deadline")

utils.postconfigure_plot(props)
utils.export_image_if_needed(props)
utils.export_data_if_needed(agg, props)
]]></script>
            <property name="Graph.Title" value="Safety track (BBox): end-to-end latency. Only MoQ with a bounded window meets the 100ms deadline"/>
        </chart>
        <chart createdWith="OMNeT++ 6.3.0" icon="icons/full/obj/linechart.png" id="910000002" name="RQ2_BBox_deadline_miss" resultTypes="scalar" template="generic_mpl" type="MATPLOTLIB">
