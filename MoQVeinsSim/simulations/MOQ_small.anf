            <script><![CDATA[from omnetpp.scave import results, chart, utils
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

# --- shared helpers -------------------------------------------------------------------------
# Runs are produced by scripts/run-comparison.sh into results/{urban,highway}/seedN/.
# Config names carry the scenario: the "_HW" suffix means highway.
ORDER = ["MOQ_Partial_BDP", "MOQ_SW_BDP", "MOQ_QUIC", "MQTT_QUIC", "MOQ_UDP", "MOQ_TCP", "MQTT_TCP"]
LABEL = {
    "MOQ_Partial_BDP": "MoQ partial\n(128kB)",
    "MOQ_SW_BDP":      "MoQ reliable\n(128kB)",
    "MOQ_QUIC":        "MoQ / QUIC\n(default)",
    "MQTT_QUIC":       "MQTT / QUIC",
    "MOQ_UDP":         "MoQ / UDP",
    "MOQ_TCP":         "MoQ / TCP",
    "MQTT_TCP":        "MQTT / TCP",
}
# t(0.975, dof) for small samples
T95 = {1: 12.706, 2: 4.303, 3: 3.182, 4: 2.776, 5: 2.571, 6: 2.447, 7: 2.365, 8: 2.306, 9: 2.262}

def ci95(x):
    x = x.dropna()
    n = len(x)
    if n < 2:
        return 0.0
    return T95.get(n - 1, 1.96) * x.std(ddof=1) / np.sqrt(n)

def load(metric_filter):
    """Return a frame with one row per (config, scenario, seed): the mean over subscriber cars."""
    df = results.get_scalars(metric_filter, include_itervars=True, include_runattrs=True)
    if df.empty:
        raise chart.ChartScriptError(
            "No data. Generate it with:  ./scripts/run-all.sh results 8")
    df = df[df["value"].notna()]
    # Split the scenario out of the config name.
    df["scenario"] = np.where(df["configname"].str.endswith("_HW"), "highway", "urban")
    df["config"] = df["configname"].str.replace("_HW$", "", regex=True)
    # MoQ over TCP/UDP and MQTT keep their own names; map ini configs onto the chart labels.
    df["config"] = df["config"].replace({"MOQ": "MOQ_QUIC"})
    df = df[df["config"].isin(ORDER)]
    # One value per run (mean across subscriber cars), then aggregate across seeds.
    per_run = df.groupby(["config", "scenario", "runID"])["value"].mean().reset_index()
    return per_run

def grouped_bar(per_run, ylabel, title, scale=1.0, logy=False, pct=False):
    agg = per_run.groupby(["config", "scenario"])["value"].agg(["mean", ci95, "count"])
    agg.columns = ["mean", "ci", "n"]
    agg = agg.reset_index()

    cfgs = [c for c in ORDER if c in set(agg["config"])]
    x = np.arange(len(cfgs))
    width = 0.38

    plt.gcf().set_size_inches(11, 5)
    for i, (scen, colour) in enumerate([("urban", "#2b6cb0"), ("highway", "#c05621")]):
        d = agg[agg["scenario"] == scen].set_index("config").reindex(cfgs)
        vals = d["mean"] * scale
        errs = d["ci"] * scale
        plt.bar(x + (i - 0.5) * width, vals, width, yerr=errs, capsize=3,
                label=scen, color=colour, alpha=0.85)

    plt.xticks(x, [LABEL.get(c, c) for c in cfgs], fontsize=9)
    plt.ylabel(ylabel)
    plt.title(title)
    if logy:
        plt.yscale("log")
    plt.legend(title="scenario")
    plt.grid(axis="y", alpha=0.3)
    plt.tight_layout()
    return agg

props = chart.get_properties()
utils.preconfigure_plot(props)

df = results.get_scalars('name =~ "*BBox*meanLatency*" AND runattr:configname =~ "MOQ_*_Window"',
                         include_itervars=True, include_runattrs=True)
if df.empty:
    raise chart.ChartScriptError("No sweep data. Run MOQ_Partial_Window and MOQ_SW_Window.")

def to_bytes(w):
    w = str(w).strip()
    if w.endswith("MB"): return float(w[:-2]) * 1e6
    if w.endswith("kB"): return float(w[:-2]) * 1e3
    return float(w)

df["window"] = df["win"].map(to_bytes) / 1e3   # kB
per_run = df.groupby(["configname", "window", "runID"])["value"].mean().reset_index()
agg = per_run.groupby(["configname", "window"])["value"].mean().reset_index()

plt.gcf().set_size_inches(8, 5)
for cfg, label, style, colour in [
        ("MOQ_Partial_Window", "Partial reliability (delivery timeout)", "-",  "#2b6cb0"),
        ("MOQ_SW_Window",      "Reliable (no shedding)",                 "--", "#c05621")]:
    d = agg[agg["configname"] == cfg].sort_values("window")
    if not d.empty:
        plt.plot(d["window"], d["value"] * 1000, style, marker="o", label=label, color=colour)

plt.xscale("log")
plt.xlabel("QUIC flow-control window (kB)  [log scale]")
plt.ylabel("BBox mean latency (ms)")
plt.yscale("log")
plt.axhline(100, color="crimson", linestyle="--", linewidth=1.2)
plt.annotate("100 ms deadline", xy=(plt.xlim()[0], 100), xytext=(4, 4),
             textcoords="offset points", color="crimson", fontsize=9)
plt.title("Safety track: latency vs transport queue depth\n(the two curves converge -- shedding adds little here)")
plt.legend(); plt.grid(alpha=0.3); plt.tight_layout()

utils.postconfigure_plot(props)
utils.export_image_if_needed(props)
utils.export_data_if_needed(agg, props)
]]></script>
            <property name="Graph.Title" value="Window sweep: the bounded window, not shedding, is what buys the deadline"/>
        </chart>
        <chart createdWith="OMNeT++ 6.3.0" icon="icons/full/obj/linechart.png" id="1439911338" name="RQ3_sweep_PCloud_latency" resultTypes="scalar" template="generic_mpl" type="MATPLOTLIB">
            <script><![CDATA[from omnetpp.scave import results, chart, utils
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

# --- shared helpers -------------------------------------------------------------------------
# Runs are produced by scripts/run-comparison.sh into results/{urban,highway}/seedN/.
# Config names carry the scenario: the "_HW" suffix means highway.
ORDER = ["MOQ_Partial_BDP", "MOQ_SW_BDP", "MOQ_QUIC", "MQTT_QUIC", "MOQ_UDP", "MOQ_TCP", "MQTT_TCP"]
LABEL = {
    "MOQ_Partial_BDP": "MoQ partial\n(128kB)",
    "MOQ_SW_BDP":      "MoQ reliable\n(128kB)",
    "MOQ_QUIC":        "MoQ / QUIC\n(default)",
    "MQTT_QUIC":       "MQTT / QUIC",
    "MOQ_UDP":         "MoQ / UDP",
    "MOQ_TCP":         "MoQ / TCP",
    "MQTT_TCP":        "MQTT / TCP",
}
# t(0.975, dof) for small samples
T95 = {1: 12.706, 2: 4.303, 3: 3.182, 4: 2.776, 5: 2.571, 6: 2.447, 7: 2.365, 8: 2.306, 9: 2.262}

def ci95(x):
    x = x.dropna()
    n = len(x)
    if n < 2:
        return 0.0
    return T95.get(n - 1, 1.96) * x.std(ddof=1) / np.sqrt(n)

def load(metric_filter):
    """Return a frame with one row per (config, scenario, seed): the mean over subscriber cars."""
    df = results.get_scalars(metric_filter, include_itervars=True, include_runattrs=True)
    if df.empty:
        raise chart.ChartScriptError(
            "No data. Generate it with:  ./scripts/run-all.sh results 8")
    df = df[df["value"].notna()]
    # Split the scenario out of the config name.
    df["scenario"] = np.where(df["configname"].str.endswith("_HW"), "highway", "urban")
    df["config"] = df["configname"].str.replace("_HW$", "", regex=True)
    # MoQ over TCP/UDP and MQTT keep their own names; map ini configs onto the chart labels.
    df["config"] = df["config"].replace({"MOQ": "MOQ_QUIC"})
    df = df[df["config"].isin(ORDER)]
    # One value per run (mean across subscriber cars), then aggregate across seeds.
    per_run = df.groupby(["config", "scenario", "runID"])["value"].mean().reset_index()
    return per_run

def grouped_bar(per_run, ylabel, title, scale=1.0, logy=False, pct=False):
    agg = per_run.groupby(["config", "scenario"])["value"].agg(["mean", ci95, "count"])
    agg.columns = ["mean", "ci", "n"]
    agg = agg.reset_index()

    cfgs = [c for c in ORDER if c in set(agg["config"])]
    x = np.arange(len(cfgs))
    width = 0.38

    plt.gcf().set_size_inches(11, 5)
    for i, (scen, colour) in enumerate([("urban", "#2b6cb0"), ("highway", "#c05621")]):
        d = agg[agg["scenario"] == scen].set_index("config").reindex(cfgs)
        vals = d["mean"] * scale
        errs = d["ci"] * scale
        plt.bar(x + (i - 0.5) * width, vals, width, yerr=errs, capsize=3,
                label=scen, color=colour, alpha=0.85)

    plt.xticks(x, [LABEL.get(c, c) for c in cfgs], fontsize=9)
    plt.ylabel(ylabel)
    plt.title(title)
    if logy:
        plt.yscale("log")
    plt.legend(title="scenario")
    plt.grid(axis="y", alpha=0.3)
    plt.tight_layout()
    return agg

props = chart.get_properties()
utils.preconfigure_plot(props)

df = results.get_scalars('name =~ "*PCloud*meanLatency*" AND runattr:configname =~ "MOQ_*_Window"',
                         include_itervars=True, include_runattrs=True)
if df.empty:
    raise chart.ChartScriptError("No sweep data. Run MOQ_Partial_Window and MOQ_SW_Window.")

def to_bytes(w):
    w = str(w).strip()
    if w.endswith("MB"): return float(w[:-2]) * 1e6
    if w.endswith("kB"): return float(w[:-2]) * 1e3
    return float(w)

df["window"] = df["win"].map(to_bytes) / 1e3   # kB
per_run = df.groupby(["configname", "window", "runID"])["value"].mean().reset_index()
agg = per_run.groupby(["configname", "window"])["value"].mean().reset_index()

plt.gcf().set_size_inches(8, 5)
for cfg, label, style, colour in [
        ("MOQ_Partial_Window", "Partial reliability (delivery timeout)", "-",  "#2b6cb0"),
        ("MOQ_SW_Window",      "Reliable (no shedding)",                 "--", "#c05621")]:
    d = agg[agg["configname"] == cfg].sort_values("window")
    if not d.empty:
        plt.plot(d["window"], d["value"] * 1, style, marker="o", label=label, color=colour)

plt.xscale("log")
plt.xlabel("QUIC flow-control window (kB)  [log scale]")
plt.ylabel("PCloud mean latency (s)")
plt.yscale("log")
plt.title("Bulk track: latency vs transport queue depth\nWithout shedding the backlog is unbounded (~14 s); with it, ~1 s")
plt.legend(); plt.grid(alpha=0.3); plt.tight_layout()

utils.postconfigure_plot(props)
utils.export_image_if_needed(props)
utils.export_data_if_needed(agg, props)
]]></script>
            <property name="Graph.Title" value="Window sweep: what shedding DOES buy is a bounded bulk track"/>
        </chart>
        <chart createdWith="OMNeT++ 6.3.0" icon="icons/full/obj/linechart.png" id="536746140" name="RQ2_BBox_latency_CDF" resultTypes="scalar" template="generic_mpl" type="MATPLOTLIB">
            <script><![CDATA[from omnetpp.scave import results, chart, utils
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

# --- shared helpers -------------------------------------------------------------------------
# Runs are produced by scripts/run-comparison.sh into results/{urban,highway}/seedN/.
# Config names carry the scenario: the "_HW" suffix means highway.
ORDER = ["MOQ_Partial_BDP", "MOQ_SW_BDP", "MOQ_QUIC", "MQTT_QUIC", "MOQ_UDP", "MOQ_TCP", "MQTT_TCP"]
LABEL = {
    "MOQ_Partial_BDP": "MoQ partial\n(128kB)",
    "MOQ_SW_BDP":      "MoQ reliable\n(128kB)",
    "MOQ_QUIC":        "MoQ / QUIC\n(default)",
    "MQTT_QUIC":       "MQTT / QUIC",
    "MOQ_UDP":         "MoQ / UDP",
    "MOQ_TCP":         "MoQ / TCP",
    "MQTT_TCP":        "MQTT / TCP",
}
# t(0.975, dof) for small samples
T95 = {1: 12.706, 2: 4.303, 3: 3.182, 4: 2.776, 5: 2.571, 6: 2.447, 7: 2.365, 8: 2.306, 9: 2.262}

def ci95(x):
    x = x.dropna()
    n = len(x)
    if n < 2:
        return 0.0
    return T95.get(n - 1, 1.96) * x.std(ddof=1) / np.sqrt(n)

def load(metric_filter):
    """Return a frame with one row per (config, scenario, seed): the mean over subscriber cars."""
    df = results.get_scalars(metric_filter, include_itervars=True, include_runattrs=True)
    if df.empty:
        raise chart.ChartScriptError(
            "No data. Generate it with:  ./scripts/run-all.sh results 8")
    df = df[df["value"].notna()]
    # Split the scenario out of the config name.
    df["scenario"] = np.where(df["configname"].str.endswith("_HW"), "highway", "urban")
    df["config"] = df["configname"].str.replace("_HW$", "", regex=True)
    # MoQ over TCP/UDP and MQTT keep their own names; map ini configs onto the chart labels.
    df["config"] = df["config"].replace({"MOQ": "MOQ_QUIC"})
    df = df[df["config"].isin(ORDER)]
    # One value per run (mean across subscriber cars), then aggregate across seeds.
    per_run = df.groupby(["config", "scenario", "runID"])["value"].mean().reset_index()
    return per_run

def grouped_bar(per_run, ylabel, title, scale=1.0, logy=False, pct=False):
    agg = per_run.groupby(["config", "scenario"])["value"].agg(["mean", ci95, "count"])
    agg.columns = ["mean", "ci", "n"]
    agg = agg.reset_index()

    cfgs = [c for c in ORDER if c in set(agg["config"])]
    x = np.arange(len(cfgs))
    width = 0.38

    plt.gcf().set_size_inches(11, 5)
    for i, (scen, colour) in enumerate([("urban", "#2b6cb0"), ("highway", "#c05621")]):
        d = agg[agg["scenario"] == scen].set_index("config").reindex(cfgs)
        vals = d["mean"] * scale
        errs = d["ci"] * scale
        plt.bar(x + (i - 0.5) * width, vals, width, yerr=errs, capsize=3,
                label=scen, color=colour, alpha=0.85)

    plt.xticks(x, [LABEL.get(c, c) for c in cfgs], fontsize=9)
    plt.ylabel(ylabel)
    plt.title(title)
    if logy:
        plt.yscale("log")
    plt.legend(title="scenario")
    plt.grid(axis="y", alpha=0.3)
    plt.tight_layout()
    return agg

props = chart.get_properties()
utils.preconfigure_plot(props)

# Per-object latencies from the vectors, urban runs only, so the tail is visible.
vec = results.get_vectors('name =~ "endToEndLatency:vector" AND runattr:configname =~ "*"',
                          include_runattrs=True)
if vec.empty:
    raise chart.ChartScriptError("No vector data. Ensure vector-recording is on for the app modules.")

vec = vec[~vec["configname"].str.endswith("_HW")]
vec["config"] = vec["configname"].replace({"MOQ": "MOQ_QUIC"})

plt.gcf().set_size_inches(8, 5)
rows = []
for cfg in ORDER:
    d = vec[vec["config"] == cfg]
    if d.empty:
        continue
    vals = np.concatenate([np.asarray(v) for v in d["vecvalue"] if len(v)])
    if not len(vals):
        continue
    vals = np.sort(vals) * 1000        # ms
    y = np.arange(1, len(vals) + 1) / len(vals)
    plt.plot(vals, y, label=LABEL.get(cfg, cfg))
    rows.append({"config": cfg, "median_ms": float(np.median(vals)), "p95_ms": float(np.percentile(vals, 95))})

agg = pd.DataFrame(rows)
plt.xscale("log")
plt.axvline(100, color="crimson", linestyle="--", linewidth=1.2)
plt.annotate("100 ms deadline", xy=(100, 0.05), xytext=(4, 0), textcoords="offset points",
             color="crimson", fontsize=9)
plt.xlabel("End-to-end latency (ms)  [log scale]")
plt.ylabel("CDF")
plt.title("Safety-critical track: latency distribution, urban scenario")
plt.legend(); plt.grid(alpha=0.3); plt.tight_layout()

utils.postconfigure_plot(props)
utils.export_image_if_needed(props)
utils.export_data_if_needed(agg, props)
]]></script>
            <property name="Graph.Title" value="Safety track (BBox): latency distribution (urban)"/>
        </chart>
        <chart createdWith="OMNeT++ 6.3.0.251110-bb3d6a4731" icon="icons/full/obj/barchart.png" id="2026095768" name="QueueLength by protocols(partial)" resultTypes="scalar" template="barchart_native" type="BAR">
            <script><![CDATA[from omnetpp.scave import results, chart, utils

# get chart properties
props = chart.get_properties()
utils.preconfigure_plot(props)

# collect parameters for query
filter_expression = props["filter"]
include_fields = props["include_fields"] == "true"

# query scalar data into dataframe
try:
    df = results.get_scalars(filter_expression, include_fields=include_fields, include_attrs=True, include_runattrs=True, include_itervars=True)
except results.ResultQueryError as e:
    raise chart.ChartScriptError("Error while querying results: " + str(e))

if df.empty:
    raise chart.ChartScriptError("The result filter returned no data.")

groups, series = utils.select_groups_series(df, props)

utils.add_legend_labels(df, props, groups + series)
utils.sort_rows_by_legend(df, props)
del df["legend"]

confidence_level = utils.get_confidence_level(props)
valuedf, errorsdf, metadf = utils.pivot_for_barchart(df, groups, series, confidence_level, sort=False)

utils.plot_bars(valuedf, errorsdf, metadf, props, sort=False)

utils.postconfigure_plot(props)

utils.export_image_if_needed(props)
utils.export_data_if_needed(df, props)
]]></script>
