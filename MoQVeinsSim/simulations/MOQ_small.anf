    width = 0.38

    plt.gcf().set_size_inches(11, 5)
    for i, (scen, colour) in enumerate([("urban", "#2b6cb0"), ("highway", "#c05621")]):
        d = agg[agg["scenario"] == scen].set_index("config").reindex(cfgs)
        vals = d["mean"] * scale
        errs = d["ci"] * scale
        plt.bar(x + (i - 0.5) * width, vals, width, yerr=errs, capsize=3,
                label=scen, color=colour, alpha=0.85)

    plt.xticks(x, [LABEL.get(c, c) for c in cfgs], fontsize=9)
    plt.ylabel(ylabel)
    plt.title(title)
    if logy:
        plt.yscale("log")
    plt.legend(title="scenario")
    plt.grid(axis="y", alpha=0.3)
    plt.tight_layout()
    return agg

props = chart.get_properties()
utils.preconfigure_plot(props)

per_run = load('name =~ "track*BBox*deadlineMissRatio*"')
agg = grouped_bar(per_run, "BBox deadline-miss ratio (%)",
                  "Safety-critical track: fraction of objects missing the 100ms deadline",
                  scale=100)
plt.ylim(0, 105)

utils.postconfigure_plot(props)
utils.export_image_if_needed(props)
utils.export_data_if_needed(agg, props)
]]></script>
